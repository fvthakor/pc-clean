# ==============================================================================
# PcClean Environment Configuration (Example)
# NOTE: Do NOT place real credentials or secrets in this file.
# Copy this file to .env for local development overrides if needed.
# ==============================================================================

# Application environment
PCCLEAN_ENV=development
PCCLEAN_LOG_LEVEL=INFO

# Optional custom override for PcClean data directory
# Default: %LOCALAPPDATA%\PcClean
# PCCLEAN_DATA_DIR=C:\Users\username\AppData\Local\PcClean

# Optional default drive selection
# PCCLEAN_DEFAULT_DRIVE=C:
